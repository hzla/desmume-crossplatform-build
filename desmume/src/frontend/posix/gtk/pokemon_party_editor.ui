<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkAdjustment" id="level_adjustment">
    <property name="lower">1</property>
    <property name="upper">100</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="hp_adjustment">
    <property name="lower">0</property>
    <property name="upper">999</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="exp_adjustment">
    <property name="lower">0</property>
    <property name="upper">5000000</property>
    <property name="step_increment">1</property>
    <property name="page_increment">1000</property>
  </object>
  <object class="GtkAdjustment" id="friendship_adjustment">
    <property name="lower">0</property>
    <property name="upper">255</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="iv_adjustment">
    <property name="lower">0</property>
    <property name="upper">31</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="ev_adjustment">
    <property name="lower">0</property>
    <property name="upper">255</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkDialog" id="dialog">
    <property name="title">Party/Box Editor</property>
    <property name="default-width">860</property>
    <property name="default-height">620</property>
    <property name="modal">False</property>
    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">12</property>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="xalign">0</property>
            <property name="label">Pokemon editor ready</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Source</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="source_combo"/>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Box</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="box_combo"/>
              <packing>
                <property name="left_attach">3</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Slot</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">4</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="slot_combo"/>
              <packing>
                <property name="left_attach">5</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Summary</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="summary_entry">
                <property name="editable">False</property>
                <property name="hexpand">True</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">1</property>
                <property name="width">5</property>
              </packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel"><property name="label">Level</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="level_spin"><property name="adjustment">level_adjustment</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">HP</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">2</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="hp_spin"><property name="adjustment">hp_adjustment</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EXP</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="exp_spin"><property name="adjustment">exp_adjustment</property><property name="numeric">True</property></object>
              <packing><property name="left_attach">5</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Species</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="species_combo">
                <property name="has-entry">True</property>
              </object>
              <packing><property name="left_attach">1</property><property name="top_attach">1</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Held Item</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="item_combo">
                <property name="has-entry">True</property>
              </object>
              <packing><property name="left_attach">4</property><property name="top_attach">1</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Ability</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">2</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="ability_combo">
                <property name="has-entry">True</property>
              </object>
              <packing><property name="left_attach">1</property><property name="top_attach">2</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Friendship</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">2</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="friendship_spin"><property name="adjustment">friendship_adjustment</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Status</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">5</property><property name="top_attach">2</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="status_combo"/>
              <packing><property name="left_attach">6</property><property name="top_attach">2</property></packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel"><property name="label">IV HP</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_hp_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">IV Atk</property></object>
              <packing><property name="left_attach">2</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_atk_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">IV Def</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_def_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">5</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">IV SpA</property></object>
              <packing><property name="left_attach">6</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_spa_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">7</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">IV SpD</property></object>
              <packing><property name="left_attach">8</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_spd_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">9</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">IV Spe</property></object>
              <packing><property name="left_attach">10</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="iv_spe_spin"><property name="adjustment">iv_adjustment</property></object>
              <packing><property name="left_attach">11</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV HP</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_hp_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV Atk</property></object>
              <packing><property name="left_attach">2</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_atk_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV Def</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_def_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">5</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV SpA</property></object>
              <packing><property name="left_attach">6</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_spa_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">7</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV SpD</property></object>
              <packing><property name="left_attach">8</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_spd_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">9</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">EV Spe</property></object>
              <packing><property name="left_attach">10</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="ev_spe_spin"><property name="adjustment">ev_adjustment</property></object>
              <packing><property name="left_attach">11</property><property name="top_attach">1</property></packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkGrid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel"><property name="label">Move 1</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="move1_combo"><property name="has-entry">True</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">0</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Move 2</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="move2_combo"><property name="has-entry">True</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">0</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Move 3</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="move3_combo"><property name="has-entry">True</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">1</property><property name="width">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel"><property name="label">Move 4</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">3</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="move4_combo"><property name="has-entry">True</property></object>
              <packing><property name="left_attach">4</property><property name="top_attach">1</property><property name="width">2</property></packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButtonBox">
            <property name="layout_style">end</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="refresh_button">
                <property name="label">Refresh</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="apply_button">
                <property name="label">Apply</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="edge_button">
                <property name="label">Edge</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="edge_party_button">
                <property name="label">Edge Party</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="bedtime_button">
                <property name="label">Bedtime</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="label">Close</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
