<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkDialog" id="dialog">
    <property name="title">Party Status/HP Editor</property>
    <property name="default-width">980</property>
    <property name="default-height">360</property>
    <property name="modal">False</property>
    <child internal-child="vbox">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">12</property>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="xalign">0</property>
            <property name="label">Pokemon party status editor ready</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="rows_grid">
            <property name="row-spacing">8</property>
            <property name="column-spacing">8</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Pokemon</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">0</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">HP</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">1</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Max</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">2</property>
                <property name="top_attach">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Quick Status</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="left_attach">3</property>
                <property name="top_attach">0</property>
                <property name="width">7</property>
              </packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButtonBox">
            <property name="layout_style">end</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="refresh_button">
                <property name="label">Refresh</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="bedtime_button">
                <property name="label">Bedtime</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="apply_button">
                <property name="label">Apply All HP</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="label">Close</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
